{
  "name": "@hindcast/cli",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "hindcast": "dist-cli/hindcast.mjs",
    "bottleneck": "dist-cli/hindcast.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "record": "node scripts/record.mjs",
    "sim": "tsx cli/bottleneck.ts",
    "mcp": "tsx mcp/server.ts",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "build:mcp-server": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-cli/hindcast-mcp.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "agent:e2e": "node scripts/agent-e2e.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "build:cli": "esbuild cli/bottleneck.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-cli/hindcast.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "docs:shots": "node scripts/docs-shots.mjs",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xyflow/react": "^12.3.0",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
