{
  "name": "@hindcast/cli",
  "private": true,
  "version": "1.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "hindcast": "bin/hindcast"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "record": "node scripts/record.mjs",
    "sim": "bin/hindcast",
    "mcp": "bin/hindcast mcp",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "agent:e2e": "node scripts/agent-e2e.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "docs:shots": "node scripts/docs-shots.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "engine:build": "cd engine-rs && cargo build --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir ../src/backtest/wasm --out-name hindcast_engine target/wasm32-unknown-unknown/release/hindcast_engine.wasm && cd .. && node scripts/engine-stamp.mjs --write",
    "cli:build": "cd engine-rs && cargo build --release --bin hindcast",
    "cli:golden": "npm run cli:build && tsx scripts/cli-golden.ts",
    "mcp:golden": "npm run cli:build && tsx scripts/mcp-golden.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xyflow/react": "^12.3.0",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
