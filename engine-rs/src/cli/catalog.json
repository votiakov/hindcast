    },
    {
      "kind": "cdn",
      "label": "CDN",
      "description": "Edge cache close to users. Serves cacheable responses; misses go to origin.",
      "capacityPerInstanceRps": 100000,
      "baseLatencyMs": 5,
      "costPerHour": 0.08,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "lb",
      "label": "Load Balancer",
      "description": "Spreads requests across healthy downstream nodes (or fails over in order). Health checks skip dead instances.",
      "capacityPerInstanceRps": 20000,
      "baseLatencyMs": 1,
      "costPerHour": 0.05,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": false
    },
    {
      "kind": "gateway",
      "label": "API Gateway",
      "description": "Routes requests and enforces a rate limit — excess gets a fast 429 instead of melting the backend.",
      "capacityPerInstanceRps": 20000,
      "baseLatencyMs": 3,
      "costPerHour": 0.08,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "server",
      "label": "API Server",
      "description": "Stateless app server. Scale out with instances (needs a load balancer in front).",
      "capacityPerInstanceRps": 250,
      "baseLatencyMs": 25,
      "costPerHour": 0.1,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": true
    },
    {
      "kind": "worker",
      "label": "Worker",
      "description": "Background job processor — slow, heavy work (payments, emails, video). Pulls from a queue or sits behind a LB.",
      "capacityPerInstanceRps": 100,
      "baseLatencyMs": 80,
      "costPerHour": 0.08,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": true
    },
    {
      "kind": "function",
      "label": "Serverless Fn",
      "description": "Scales automatically up to a concurrency limit. Pay per request ($0.60 / 1M). Cold starts when scaling up fast.",
      "capacityPerInstanceRps": 3000,
      "baseLatencyMs": 35,
      "costPerHour": 0,
      "costPerRequest": 6e-7,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "cache",
      "label": "Cache",
      "description": "In-memory cache. Hits return immediately; misses fall through to the next node.",
      "capacityPerInstanceRps": 20000,
      "baseLatencyMs": 1,
      "costPerHour": 0.15,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": false
    },
    {
      "kind": "db",
      "label": "Database",
      "description": "Primary database. Handles all writes. Connect Read Replicas to it to offload reads — and to fail over.",
      "capacityPerInstanceRps": 1000,
      "baseLatencyMs": 10,
      "costPerHour": 0.4,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": false
    },
    {
      "kind": "replica",
      "label": "Read Replica",
      "description": "Connect from a Database. Serves a share of reads. Promoted to primary automatically if the primary dies.",
      "capacityPerInstanceRps": 1000,
      "baseLatencyMs": 10,
      "costPerHour": 0.35,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": false
    },
    {
      "kind": "storage",
      "label": "Object Storage",
      "description": "S3-style object storage: slow per request, and 5,500 reads or 3,500 writes a second per key prefix (10 prefixes by default) — a hot prefix gets 503 SlowDown however big the bucket.",
      "capacityPerInstanceRps": 55000,
      "baseLatencyMs": 40,
      "costPerHour": 0.03,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "queue",
      "label": "Queue",
      "description": "Async buffer. Producers get an instant ack; consumers drain at their own pace. Spikes become backlog, not errors.",
      "capacityPerInstanceRps": 50000,
      "baseLatencyMs": 3,
      "costPerHour": 0.06,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "llm",
      "label": "GPU Inference",
      "description": "Self-hosted model on GPUs (one instance = one GPU). Continuous batching packs ~4× more requests per GPU at the cost of latency.",
      "capacityPerInstanceRps": 6,
      "baseLatencyMs": 800,
      "costPerHour": 4,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": true
    },
    {
      "kind": "llmapi",
      "label": "LLM Provider API",
      "description": "Hosted model API. Scales for you, but enforces a rate limit (429s) and bills per request (~$0.002).",
      "capacityPerInstanceRps": 100,
      "baseLatencyMs": 1500,
      "costPerHour": 0,
      "costPerRequest": 0.002,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "stream",
      "label": "Stream",
      "description": "A log you publish to and many subscribe to (Kinesis, Kafka): every subscriber reads every message at its own pace. Per partition: 1,000 messages/s in, $0.015/h, and one consumer — a subscriber cannot use more instances than there are partitions.",
      "capacityPerInstanceRps": 1000,
      "baseLatencyMs": 5,
      "costPerHour": 0.015,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "dns",
      "label": "DNS",
      "description": "A name with health-checked answers (Route 53): sends users to their region, or fails over to the next. Clients cache the answer for the TTL, so a dead target keeps getting traffic until the health check notices and the caches expire.",
      "capacityPerInstanceRps": 1000000000,
      "baseLatencyMs": 1,
      "costPerHour": 0.001,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "kv",
      "label": "Key-Value Store",
      "description": "Managed NoSQL (DynamoDB on demand): no box to size and billed per request — but one partition takes 3,000 reads or 1,000 writes a second, so a hot key throttles whatever the table allows.",
      "capacityPerInstanceRps": 40000,
      "baseLatencyMs": 5,
      "costPerHour": 0,
      "costPerRequest": 4.5000000000000003e-7,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "search",
      "label": "Search Index",
      "description": "Full-text search (OpenSearch, Elasticsearch): data nodes that share the queries between them — no load balancer needed. A write is searchable only after the next refresh (1 s by default), later still when indexing queues behind busy nodes.",
      "capacityPerInstanceRps": 200,
      "baseLatencyMs": 20,
      "costPerHour": 0.2,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": true
    },
    {
      "kind": "vector",
      "label": "Vector Database",
      "description": "Nearest-neighbour search over embeddings (OpenSearch k-NN, pgvector): an HNSW graph spread over its nodes. Higher recall walks more of the graph — 0.99 costs five times 0.95 — and a graph that does not fit in memory is read from disk.",
      "capacityPerInstanceRps": 300,
      "baseLatencyMs": 10,
      "costPerHour": 0.2,
      "costPerRequest": null,
      "sizable": true,
      "scalesHorizontally": true
    },
    {
      "kind": "edge",
      "label": "Edge Function",
      "description": "Code at the edge (CloudFront Functions, Cloudflare Workers): runs before the origin on every request, answers some itself (redirects, auth checks, A/B, personalisation) in milliseconds and passes the rest on. Each request gets a CPU time limit — heavy work past it is killed.",
      "capacityPerInstanceRps": 100000,
      "baseLatencyMs": 2,
      "costPerHour": 0,
      "costPerRequest": 3.2e-7,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "archive",
      "label": "Archive Storage",
      "description": "Cold storage (S3 Glacier): a tenth of the price of hot storage to keep, priced per retrieval to read. Instant Retrieval answers in milliseconds; Flexible Retrieval restores take minutes (expedited) or hours (standard) — no user can wait for that.",
      "capacityPerInstanceRps": 5500,
      "baseLatencyMs": 40,
      "costPerHour": 0,
      "costPerRequest": 0.000039296875,
      "sizable": false,
      "scalesHorizontally": false
    },
    {
      "kind": "external",
      "label": "External API",
      "description": "Someone else's service: a payment provider, a partner API, the websites a crawler fetches. You cannot size it — only respect its rate limit and live with its latency and errors.",
      "capacityPerInstanceRps": 1000,
      "baseLatencyMs": 200,
      "costPerHour": 0,
      "costPerRequest": null,
      "sizable": false,
      "scalesHorizontally": false
    }
